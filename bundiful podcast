</main>

<footer><div class="wrap foot"><span>© 2026 Bundieful Podcast</span><span>Real Talk • Real Faith • Real Impact</span></div></footer>
<script>
const io=new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting&&e.target.classList.add("show")),{threshold:.12});
document.querySelectorAll(".reveal").forEach(x=>io.observe(x));
document.querySelector(".menu").onclick=()=>{const n=document.querySelector(".navlinks");n.style.display=n.style.display==="flex"?"none":"flex";n.style.position="absolute";n.style.top="78px";n.style.left="0";n.style.right="0";n.style.padding="22px";n.style.background="#050505";n.style.flexDirection="column"};
</script>
